  "components": {
    "schemas": {
      "AlertResponse": {
        "properties": {
          "item_id": {
            "type": "integer",
            "title": "Item Id"
          },
          "current_stock": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Current Stock"
          },
          "safe_stock": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Safe Stock"
          },
          "alert_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Alert Source"
          },
          "alert_status": {
            "type": "string",
            "title": "Alert Status"
          },
          "is_low_stock": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Low Stock"
          }
        },
        "type": "object",
        "required": [
          "item_id",
          "current_stock",
          "safe_stock",
          "alert_source",
          "alert_status",
          "is_low_stock"
        ],
        "title": "AlertResponse"
      },
      "AssessmentResponse": {
        "properties": {
          "safe_stock": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Safe Stock"
          },
          "alert_source": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "MANUAL_THRESHOLD",
                  "AUTOMATIC"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Alert Source"
          },
          "alert_status": {
            "type": "string",
            "enum": [
              "LOW_STOCK",
              "OK",
              "INSUFFICIENT_HISTORY"
            ],
            "title": "Alert Status"
          },
          "is_low_stock": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Low Stock"
          },
          "target_stock": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Stock"
          },
          "suggested_quantity": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggested Quantity"
          },
          "daily_average": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Daily Average"
          },
          "remaining_days": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remaining Days"
          },
          "depletion_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Depletion At"
          },
          "depletion_status": {
            "type": "string",
            "enum": [
              "INSUFFICIENT_HISTORY",
              "ZERO_CONSUMPTION",
              "PROJECTED",
              "OUT_OF_RANGE"
            ],
            "title": "Depletion Status"
          }
        },
        "type": "object",
        "required": [
          "safe_stock",
          "alert_source",
          "alert_status",
          "is_low_stock",
          "target_stock",
